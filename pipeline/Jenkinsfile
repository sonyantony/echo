// Sample Jenkins pipeline for an EY ECHO flow repository.
// Copy pipeline/ and runtime-template/ from the EY ECHO repository into the root of the flow
// repository and point a Jenkins (multibranch) pipeline job at pipeline/Jenkinsfile.
//
// BUILD_MODE decides what it builds and pushes to your registry:
//   bundle   (default): one image, echo-flows:1.0.<build number>, with every flow in flows/, rebuilt
//                       when any flow changes. Flows share one port, so each needs its own Base Path;
//                       the build fails and lists the clashes otherwise.
//   per-flow: one image per flow, echo-flow-<flow>:<version>, for every flow changed since the last
//             successful build.
// Only flows/ is built: templates/ (the Builder's Save As Template) is ignored. Promotion between
// environments stays with your own release process.
//
// Each build also writes Kubernetes manifests next to each image, build/<app>/k8s/ (Deployment,
// Service, and an Ingress for only the flows' paths; settings in pipeline/k8s.properties), and keeps
// them as build artifacts. DEPLOY applies them with kubectl; leave it off to hand them to your own
// release process or GitOps tool instead.
//
// Agent needs: Java 21, Maven, curl, git. No Docker daemon needed (Jib pushes directly). DEPLOY also
// needs kubectl.
pipeline {
  agent any

  parameters {
    // bundle = all flows in one image. per-flow (one image per flow) is also available.
    choice(name: 'BUILD_MODE', choices: ['bundle', 'per-flow'],
           description: 'bundle: all flows in one image. per-flow: one image per changed flow.')
    string(name: 'REGISTRY_URL', defaultValue: 'registry.example.com/echo',
           description: 'Registry and namespace, e.g. mycompany.jfrog.io/echo-docker')
    string(name: 'REGISTRY_CREDENTIALS_ID', defaultValue: 'echo-registry',
           description: 'Jenkins username/password credentials for the registry')
    booleanParam(name: 'BUILD_ALL', defaultValue: false,
                 description: 'Build even if no flow changed (per-flow: build every flow)')
    booleanParam(name: 'DEPLOY', defaultValue: false,
                 description: 'Apply the Kubernetes manifests (build/*/k8s) with kubectl after the build')
    string(name: 'KUBECONFIG_CREDENTIALS_ID', defaultValue: 'echo-kubeconfig',
           description: 'Jenkins secret file credentials with the kubeconfig DEPLOY uses')
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  stages {
    stage('Find changed flows') {
      steps {
        script {
          def base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
          def folders
          if (params.BUILD_ALL || !base) {
            folders = sh(returnStdout: true, script: 'ls -d flows/*/ 2>/dev/null | xargs -n1 basename || true')
          } else {
            folders = sh(returnStdout: true, script: """
              git diff --name-only ${base} HEAD -- flows/ | cut -d/ -f2 | sort -u
            """)
          }
          // Skip deleted flows: only folders that still have a route file.
          env.FLOWS = folders.split('\n').findAll { it && fileExists("flows/${it}/${it}.camel.yaml") }.join(' ')
          if (params.BUILD_MODE == 'bundle' && fileExists('flows') && (folders.trim() || params.BUILD_ALL)) {
            // Any change, including a deleted flow, rebuilds the one image from every flow.
            env.FLOWS = 'ALL'
          }
          echo "Flows to build: ${env.FLOWS ?: '(none)'}"
        }
      }
    }

    stage('Build and push images') {
      when { expression { env.FLOWS?.trim() } }
      steps {
        withCredentials([usernamePassword(credentialsId: params.REGISTRY_CREDENTIALS_ID,
                                          usernameVariable: 'REGISTRY_USERNAME',
                                          passwordVariable: 'REGISTRY_PASSWORD')]) {
          script {
            // Only this build's apps, so DEPLOY never applies the manifests of an earlier build.
            sh 'rm -rf build'
            if (params.BUILD_MODE == 'bundle') {
              sh "pipeline/build-flow.sh flows --mode bundle --version 1.0.${env.BUILD_NUMBER} --registry '${params.REGISTRY_URL}'"
            } else {
              for (flow in env.FLOWS.split(' ')) {
                stage("Flow ${flow}") {
                  sh "pipeline/build-flow.sh flows/${flow} --mode per-flow --registry '${params.REGISTRY_URL}'"
                }
              }
            }
          }
        }
      }
    }

    stage('Deploy to Kubernetes') {
      when { expression { params.DEPLOY && env.FLOWS?.trim() } }
      steps {
        withCredentials([file(credentialsId: params.KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG')]) {
          sh 'for dir in build/*/k8s; do kubectl apply -f "$dir"; done'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'build/*/image.txt, build/*/k8s/*.yaml', allowEmptyArchive: true
    }
  }
}
