{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order request (inbound)",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "customer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "qty": { "type": "number" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
